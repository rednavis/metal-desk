# Copy to .env.local to override. Base URLs and flags only: nothing secret belongs in a Vite env file,
# because everything prefixed VITE_ is compiled into the public bundle.

# Where the app sends API calls. The default is the dev-server proxy path, which is also what a
# deployment behind one load balancer uses; set a full URL only if the API is on another origin.
VITE_API_BASE_URL=/api

# Dev server only (not compiled into the bundle): where `/api` is proxied to.
# API_PROXY_TARGET=http://localhost:8082

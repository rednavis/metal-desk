{
  "name": "timeout",
  "request": {
    "method": "POST",
    "urlPath": "/v1/payments",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.orderId == 'order-timeout')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 3000,
    "bodyFileName": "captured.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}

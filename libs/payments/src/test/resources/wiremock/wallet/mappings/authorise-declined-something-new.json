{
  "name": "declined-something-new",
  "request": {
    "method": "POST",
    "urlPath": "/v1/wallet/payments",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.orderId == 'order-declined-something_new')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "status": "declined",
      "declineCode": "something_new"
    }
  }
}

{
  "name": "declined-instrument-expired",
  "request": {
    "method": "POST",
    "urlPath": "/v1/payments",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.orderId == 'order-declined-instrument_expired')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "status": "declined",
      "declineCode": "instrument_expired"
    }
  }
}
